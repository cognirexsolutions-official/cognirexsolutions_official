# ==============================================================================
# Cognirex Solutions — Production Environment Variables Configuration (Website + CMS)
# ==============================================================================

# Production Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://cognirexsolutions.in

# FormSubmit.co Integration (Zero-Backend Direct Inbox Delivery)
NEXT_PUBLIC_CONTACT_EMAIL=info@cognirexsolutions.in
NEXT_PUBLIC_CAREERS_EMAIL=info@cognirexsolutions.in

# CMS Admin Whitelist & Default Bootstrap Admin
AUTHORIZED_EMAILS=info@cognirexsolutions.in,admin@cognirexsolutions.in
SUPER_ADMIN_EMAIL=info@cognirexsolutions.in
ADMIN_DEFAULT_PASSWORD=Cognirex@Admin2026

# JWT Authentication Secrets (Pre-generated 64-character cryptographic tokens)
JWT_SECRET=bb6363858345d83364667c305c7f418c3115a698e892bb4b353fcffec3ebaecc
JWT_REFRESH_SECRET=0a08b65e872f6c427c08a3c65643e6ea61fa383bca69a7269ac35228bcae2d7a

# MongoDB Connection URI (Cognirex Database — e.g. cognirex_db)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cognirex_db?retryWrites=true&w=majority&appName=Cluster0

# SMTP Email Configuration (Nodemailer — for CMS replies, alerts & booking confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@cognirexsolutions.in
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM="Cognirex Solutions Notifications" <info@cognirexsolutions.in>
EMAIL_FROM=info@cognirexsolutions.in
SMTP_TO_EMAIL=info@cognirexsolutions.in
SMTP_TO_CAREERS_EMAIL=info@cognirexsolutions.in
ADMIN_EMAIL=info@cognirexsolutions.in

# Google OAuth (Optional — for "Sign in with Google" in /cms/login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary Media Library (Optional — falls back to database/local assets if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
